# Copy this file to .env. Never put real credentials in this template.
PORT=3001
TRUST_PROXY_HOPS=0
WEB_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
GUEST_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_CALL_TYPE=default
ROOM_TTL_HOURS=24
ALLOW_FILE_STORAGE=false
# Leave empty to use the same domain for the frontend and API.
VITE_API_URL=
# Production serves the frontend build automatically; opt in locally with true.
SERVE_WEB=false
