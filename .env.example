# Local development works without external services; file snapshots live in .data/.
PORT=3001
WEB_ORIGIN=http://localhost:5173
# Required for production. Use a random secret of at least 32 characters.
GUEST_TOKEN_SECRET=
# Set to enable PostgreSQL instead of local file storage, then run npm run db:push.
DATABASE_URL=
# Configure a LiveKit Cloud project, or use the local Docker LiveKit service.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ROOM_TTL_HOURS=24
# Use VITE_API_URL for a separately hosted API; otherwise use the same-origin /api proxy.
VITE_API_URL=
