    "@nestjs/websockets": "^11.1.11",
    "@prisma/client": "6.19.0",
    "@stream-io/node-sdk": "^0.8.12",
    "@catsketch/shared": "*",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
